# ── Copia este archivo como .env y completa los valores ──

# Puerto (Railway lo pone automáticamente, no tocar)
PORT=3000

# Tu API Key de Google Sheets
GOOGLE_API_KEY=AIzaSy...

# Clave secreta para proteger los endpoints (invéntate una cadena larga)
API_SECRET=cambia_esto_por_algo_secreto_123

# (Opcional) Usuarios permitidos — separados por coma
# Si lo dejas vacío, cualquier nombre de usuario es válido
ALLOWED_USERS=ana,pedro,carlos
